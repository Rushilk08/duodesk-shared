# =============================================================================
# DuoDesk Environment Configuration
# Copy to .env (backend) and .env.local (frontend) — never commit real secrets.
# =============================================================================

# --- FRONTEND (Vite public variables only; NEVER put service_role keys here) ---
# URL of the deployed Python FastAPI backend (e.g. http://localhost:8000 or https://api.duodesk.app)
# Leave empty to run the local demonstration preview.
VITE_API_BASE_URL=""

# Supabase Project URL & Publishable/Anon Key (used ONLY for Supabase Realtime)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- BACKEND ONLY (Python FastAPI) ---
# Supabase Project URL
SUPABASE_URL=""

# Supabase Anon / Publishable Key (used for auth sign-in/up proxy)
SUPABASE_ANON_KEY=""

# Supabase Service Role Key — SECRET! Backend only, never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase JWT Secret (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_JWT_SECRET=""

# Optional direct PostgreSQL connection string (for migrations/admin scripts)
DATABASE_URL=""

# Storage bucket names (created by supabase/migrations/001_duodesk_schema_and_rls.sql)
STORAGE_PRIVATE_BUCKET="duodesk-private"
STORAGE_SHARED_BUCKET="duodesk-shared"

# Comma-separated CORS origins allowed to call FastAPI
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Public URL of the frontend website (used in invitation links & password reset redirects)
APP_URL="http://localhost:3000"

# AI Studio runtime defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
